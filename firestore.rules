rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /products/{id} {
      allow get, list: if resource.data.active == true || admin();
      allow create, update: if admin();
      allow delete: if false; // preserve products; use active=false instead
    }
    match /categories/{id} {
      allow get, list: if resource.data.active == true || admin();
      allow create, update: if admin();
      allow delete: if false; // category removal is performed only after product checks
    }
    match /settings/{id} {
      allow read: if id == 'store';
      allow write: if admin();
    }
    match /coupons/{id} {
      allow get: if resource.data.active == true || admin();
      allow list: if admin();
      allow create, update: if admin();
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create, update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'lastSeen', 'createdAt']);
      allow delete: if false;
      match /addresses/{addressId} {
        allow read, create, update, delete: if owner(uid);
      }
    }
    match /orders/{id} {
      allow get, list: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false; // only verified Cloud Functions may write orders
    }
    match /salesStats/{id} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
